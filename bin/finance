#!/usr/bin/env bash
# Personal Finance Manager control script.
#
#   finance            start the server (if needed) and open the app
#   finance start      start the server in the background
#   finance stop       stop the server
#   finance restart    stop then start
#   finance status     is it running, and what OCR engines are available
#   finance open       open the app in your browser
#   finance logs       follow the server log
#   finance read IMG   read a screenshot in the terminal, save nothing
#   finance export F   write all transactions to a CSV file
#   finance check      test the screenshot parsers and merchant name rules
#   finance reparse    re-read stored imports after a parser change
#   finance shell      open a Python shell with the app importable
#   finance install    put `finance` on your PATH so it works from anywhere
#   finance doctor     check the install and report anything broken

set -euo pipefail

# Resolve symlinks before working out the repo root, because `finance install`
# links this script into ~/.local/bin and dirname of the link is not the repo.
# macOS has no `readlink -f`, so the links are followed by hand.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    TARGET="$(readlink "$SOURCE")"
    case "$TARGET" in
        /*) SOURCE="$TARGET" ;;
        *)  SOURCE="$(cd "$(dirname "$SOURCE")" && pwd)/$TARGET" ;;
    esac
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
VENV="$ROOT/.venv"
PYTHON="$VENV/bin/python"
HOST="${FINANCE_HOST:-127.0.0.1}"
PORT="${FINANCE_PORT:-8000}"
URL="http://$HOST:$PORT"
RUN_DIR="$ROOT/data"
PID_FILE="$RUN_DIR/server.pid"
LOG_FILE="$RUN_DIR/server.log"

say () { printf '%s\n' "$*"; }
die () { printf 'error: %s\n' "$*" >&2; exit 1; }

ensure_venv () {
    if [ ! -x "$PYTHON" ]; then
        say "First run: creating the virtualenv..."
        python3 -m venv "$VENV"
        "$VENV/bin/pip" install --quiet --upgrade pip
        "$VENV/bin/pip" install --quiet -r "$ROOT/requirements.txt"
        say "Dependencies installed."
    fi
}

server_pid () {
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    [ -n "$pid" ] || return 1
    # Only trust the pidfile if that process is actually still ours.
    if kill -0 "$pid" 2>/dev/null; then
        printf '%s' "$pid"
        return 0
    fi
    rm -f "$PID_FILE"
    return 1
}

# Every process currently listening on our port. A reloader leaves a parent and
# a worker, and wiping data/ can drop the pidfile while they keep running, so
# stop has to catch all of them — not just the one we started.
port_pids () {
    command -v lsof >/dev/null 2>&1 || return 0
    lsof -nP -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true
}

port_pid () {
    local pid
    pid="$(port_pids | head -n 1)"
    [ -n "$pid" ] || return 1
    printf '%s' "$pid"
}

# Unique pids from the pidfile and the port, in that order.
running_pids () {
    local seen=" " pid
    for pid in "$(server_pid || true)" $(port_pids); do
        [ -n "$pid" ] || continue
        case "$seen" in
            *" $pid "*) continue ;;
        esac
        seen="$seen$pid "
        printf '%s\n' "$pid"
    done
}

wait_until_up () {
    for _ in $(seq 1 40); do
        if curl -fsS "$URL/health" >/dev/null 2>&1; then return 0; fi
        sleep 0.25
    done
    return 1
}

cmd_start () {
    ensure_venv
    mkdir -p "$RUN_DIR" "$LINK_DIR"
    # Keep the PATH command pointing at this repo even if the previous link
    # was deleted or left pointing at an old copy.
    ln -sf "$SELF" "$LINK"

    # Healthy and we know the pid: nothing to do.
    if pid="$(server_pid)" && curl -fsS "$URL/health" >/dev/null 2>&1; then
        say "Already running (pid $pid) at $URL"
        return 0
    fi

    # Healthy but the pidfile was lost (wiping data/ while it ran). Adopt it
    # so a later `finance stop` still works.
    if curl -fsS "$URL/health" >/dev/null 2>&1; then
        pid="$(port_pid || true)"
        if [ -n "$pid" ]; then
            printf '%s' "$pid" > "$PID_FILE"
            say "Already running (pid $pid) at $URL"
            return 0
        fi
        say "Already running at $URL"
        return 0
    fi

    # Port taken by something that is not us (a crashed reloader, another
    # app). Steal it so start never gets stuck behind a dead listener.
    if port_pid >/dev/null; then
        say "Port $PORT is busy; stopping whatever is there first."
        cmd_stop
    fi

    # Started in its own session (setsid) so it survives closing this terminal.
    # `nohup ... &` is not enough: the shell's process group gets signalled.
    cd "$ROOT"
    "$PYTHON" - "$VENV/bin/uvicorn" "$HOST" "$PORT" "$LOG_FILE" "$PID_FILE" <<'LAUNCH'
import subprocess, sys
uvicorn, host, port, log_path, pid_path = sys.argv[1:6]
with open(log_path, "ab") as log:
    process = subprocess.Popen(
        [uvicorn, "app.main:app", "--host", host, "--port", port],
        stdout=log, stderr=log, stdin=subprocess.DEVNULL,
        start_new_session=True,
    )
with open(pid_path, "w") as handle:
    handle.write(str(process.pid))
LAUNCH

    if wait_until_up; then
        say "Started at $URL (pid $(cat "$PID_FILE"), log: $LOG_FILE)"
    else
        say "The server did not come up. Last lines of $LOG_FILE:"
        tail -n 20 "$LOG_FILE" || true
        return 1
    fi
}

cmd_stop () {
    local pids pid leftover
    pids="$(running_pids)"
    if [ -z "$pids" ]; then
        say "Not running."
        rm -f "$PID_FILE"
        return 0
    fi

    for pid in $pids; do
        kill "$pid" 2>/dev/null || true
    done
    for _ in $(seq 1 20); do
        leftover=0
        for pid in $pids; do
            kill -0 "$pid" 2>/dev/null && leftover=1
        done
        [ "$leftover" -eq 0 ] && break
        sleep 0.1
    done
    for pid in $pids $(port_pids); do
        [ -n "$pid" ] || continue
        kill -9 "$pid" 2>/dev/null || true
    done
    rm -f "$PID_FILE"

    # The socket can linger after the last process dies. Wait until the port
    # is genuinely free so an immediate restart does not collide with it.
    for _ in $(seq 1 40); do
        leftover="$(port_pid || true)"
        [ -z "$leftover" ] && break
        kill -9 "$leftover" 2>/dev/null || true
        sleep 0.25
    done
    say "Stopped."
}

# Where the `finance` command gets linked. A symlink on PATH beats a shell alias:
# it works in non-interactive shells, scripts and cron, and it keeps working if
# this repo moves because the link is followed to resolve ROOT.
LINK_DIR="$HOME/.local/bin"
LINK="$LINK_DIR/finance"
SELF="$ROOT/bin/finance"

_ensure_path_line () {
    # $1 = rc file. Login shells read .zprofile; interactive ones read .zshrc.
    # Writing both means `finance` works in Terminal.app, iTerm, and Cursor.
    local rc="$1"
    local line='export PATH="$HOME/.local/bin:$PATH"'
    touch "$rc"
    if grep -qF '$HOME/.local/bin' "$rc"; then
        say "$rc already puts ~/.local/bin on PATH"
        return 0
    fi
    printf '\n# Added by `finance install`\n%s\n' "$line" >> "$rc"
    say "added ~/.local/bin to PATH in $rc"
}

_ensure_zsh_function () {
    # A function beats PATH: conda, nvm and similar rewrite PATH after .zshrc
    # has run, which is how `finance` used to vanish from a later terminal.
    local rc="$HOME/.zshrc"
    local marker='# finance CLI (added by `finance install`)'
    touch "$rc"
    if grep -qF "$marker" "$rc"; then
        say "$rc already defines the finance function"
        return 0
    fi
    cat >> "$rc" <<'EOF'

# finance CLI (added by `finance install`)
finance() { command "$HOME/.local/bin/finance" "$@"; }
EOF
    say "added a finance() function to $rc"
}

cmd_install () {
    mkdir -p "$LINK_DIR"
    ln -sf "$SELF" "$LINK"
    say "linked $LINK -> $SELF"

    _ensure_path_line "$HOME/.zshrc"
    _ensure_path_line "$HOME/.zprofile"
    _ensure_path_line "$HOME/.bashrc"
    _ensure_path_line "$HOME/.profile"
    _ensure_zsh_function

    case ":$PATH:" in
        *":$LINK_DIR:"*) say "Ready. Type: finance" ;;
        *) say "Ready in new terminals. For this one: export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
    esac
}

cmd_doctor () {
    local problems=0

    if [ -L "$LINK" ] && [ "$(readlink "$LINK")" = "$SELF" ]; then
        say "ok      $LINK -> $SELF"
    elif [ -e "$LINK" ]; then
        say "PROBLEM $LINK points at $(readlink "$LINK" || echo 'a real file'), not $SELF"
        problems=$((problems + 1))
    else
        say "PROBLEM $LINK missing. Run: $SELF install"
        problems=$((problems + 1))
    fi

    case ":$PATH:" in
        *":$LINK_DIR:"*) say "ok      $LINK_DIR is on PATH" ;;
        *) say "PROBLEM $LINK_DIR is not on PATH in this shell"
           problems=$((problems + 1)) ;;
    esac

    if grep -qF '$HOME/.local/bin' "$HOME/.zshrc" 2>/dev/null; then
        say "ok      ~/.zshrc puts it on PATH for new terminals"
    else
        say "PROBLEM ~/.zshrc does not add $LINK_DIR to PATH. Run: $SELF install"
        problems=$((problems + 1))
    fi

    if grep -qF 'finance CLI (added by `finance install`)' "$HOME/.zshrc" 2>/dev/null; then
        say "ok      ~/.zshrc defines finance() so PATH rewrites cannot hide it"
    else
        say "PROBLEM ~/.zshrc has no finance() function. Run: $SELF install"
        problems=$((problems + 1))
    fi

    if [ -x "$PYTHON" ]; then
        say "ok      virtualenv at $VENV"
    else
        say "PROBLEM no virtualenv yet; it is created on first start"
    fi

    command -v lsof >/dev/null 2>&1 \
        && say "ok      lsof present, so stop works without the pidfile" \
        || say "PROBLEM lsof missing; stop can only use $PID_FILE"

    cmd_status

    [ "$problems" -eq 0 ] && say "Nothing to fix." || say "$problems problem(s) above."
}

cmd_open () {
    if command -v open >/dev/null 2>&1; then open "$URL"
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL"
    else say "Open this in your browser: $URL"; fi
}

cmd_status () {
    if pid="$(server_pid)"; then
        say "running   pid $pid"
    elif pid="$(port_pid)"; then
        printf '%s' "$pid" > "$PID_FILE"
        say "running   pid $pid (adopted; stop will work now)"
    else
        say "stopped"
    fi
    say "url       $URL"
    say "database  $ROOT/data/finance.db"
    local idle="${FINANCE_IDLE_TIMEOUT_MINUTES:-60}"
    if [ "$idle" = "0" ]; then
        say "idle      never (FINANCE_IDLE_TIMEOUT_MINUTES=0)"
    else
        say "idle      stops after $idle min without a page view"
    fi
    if curl -fsS "$URL/health" 2>/dev/null; then echo; fi
}

case "${1:-up}" in
    up|"")      cmd_start; cmd_open ;;
    start)      cmd_start ;;
    stop)       cmd_stop ;;
    restart)    cmd_stop; cmd_start ;;
    status)     cmd_status ;;
    open)       cmd_open ;;
    logs)       tail -n 40 -f "$LOG_FILE" ;;
    read)       shift; ensure_venv; cd "$ROOT" && "$PYTHON" tools/read_image.py "$@" ;;
    export)     shift
                [ $# -ge 1 ] || die "usage: finance export FILE.csv"
                ensure_venv
                cd "$ROOT" && "$PYTHON" -c "
import sys
from app import csv_io, db
target = sys.argv[1]
rows = db.list_transactions()
open(target, 'w', encoding='utf-8').write(csv_io.export_rows(rows))
print(f'wrote {len(rows)} transaction(s) to {target}')
" "$1" ;;
    install)    cmd_install ;;
    doctor)     cmd_doctor ;;
    check)      ensure_venv; cd "$ROOT" && "$PYTHON" tools/check_parsers.py ;;
    reparse)    shift; ensure_venv
                cd "$ROOT" && "$PYTHON" tools/reparse_imports.py "$@" ;;
    shell)      ensure_venv; cd "$ROOT" && "$PYTHON" ;;
    -h|--help|help)
        # Print the comment block at the top of this file, and stop at its end.
        awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' \
            "${BASH_SOURCE[0]}" ;;
    *)          die "unknown command '$1'. Try: finance --help" ;;
esac
